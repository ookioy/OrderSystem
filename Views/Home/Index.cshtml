@{
    ViewData["Title"] = "Головна - OrderSystem";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold">OrderSystem: Лабораторна робота №1</h1>
    
    <div class="alert alert-success mt-4 p-4 shadow-sm" role="alert">
        <h4 class="alert-heading">Повідомлення системи</h4>
        <p class="fs-5">@ViewData["WelcomeMessage"]</p>
        <hr>
        <p class="mb-0 text-muted">Поточний серверний час (ITimeService): <strong>@ViewData["ServerTime"]</strong></p>
    </div>

    <div class="mt-4">
        <a href="/Products" class="btn btn-primary btn-lg">Перейти до каталогу товарів (/Products)</a>
    </div>
</div>